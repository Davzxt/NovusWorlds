{
  "name": "novus-worlds",
  "version": "1.0.0",
  "description": "Novus Worlds, a retro 2008 browser multiplayer platform.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "seed": "node server/db.js --seed",
    "godot:build": "powershell -ExecutionPolicy Bypass -File tools/build-godot-projects.ps1",
    "godot:server": "powershell -ExecutionPolicy Bypass -File tools/run-godot-server.ps1",
    "godot:client": "powershell -ExecutionPolicy Bypass -File tools/run-godot-client.ps1",
    "godot:studio": "powershell -ExecutionPolicy Bypass -File tools/run-godot-studio.ps1",
    "godot:export:windows": "powershell -ExecutionPolicy Bypass -File tools/export-godot-windows.ps1",
    "godot:export:server": "powershell -ExecutionPolicy Bypass -File tools/export-godot-server-linux.ps1",
    "godot:templates": "powershell -ExecutionPolicy Bypass -File tools/install-godot-export-templates.ps1"
  },
  "dependencies": {
    "babylonjs": "^8.39.0",
    "babylonjs-loaders": "^8.39.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.0.2",
    "three": "^0.155.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.1"
  }
}
