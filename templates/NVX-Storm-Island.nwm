    "scripts": [
      {"id":"round_controller","name":"DisasterRoundController","parentId":"","source":"local disasters = {\"Meteor Shower\", \"Flash Flood\", \"Volcanic Eruption\", \"Lightning Storm\"}\nlocal roundTime = 90\n\nprint(\"NVX Storm Island loaded\")\n\ngame.on(\"playerJoin\", function(player)\n  player:setHealth(100)\n  player:teleport(0, 6, 0)\nend)\n\nfunction startRound()\n  local disaster = disasters[math.random(1, #disasters)]\n  print(\"Disaster: \" .. disaster)\n  for _, player in pairs(game.players) do\n    player:teleport(0, 8, -42)\n    game.setScore(player.id, 0)\n  end\nend\n","disabled":false}
